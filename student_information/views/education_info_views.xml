<odoo>

    <record id="education_info_tree_view" model="ir.ui.view">
        <field name="name">education.info.tree.view</field>
        <field name="model">education.info</field>
        <field name="arch" type="xml">
            <list>
                <field name="name"/>
                <field name="percentage"/>
                <field name="place"/>
                <field name="student_id"/>
                <field name="tag_ids" widget="many2many_tags"/>
            </list>
        </field>
    </record>

    <record id="education_info_form_view" model="ir.ui.view">
        <field name="name">education.info.form.view</field>
        <field name="model">education.info</field>
        <field name="arch" type="xml">
            <form>
                <sheet>
                    <group>
                        <field name="name"/>
                        <field name="percentage"/>
                        <field name="place"/>
                        <field name="tag_ids" widget="many2many_tags"/>
                    </group>
                </sheet>
            </form>
        </field>
    </record>

    <record id="action_education_info" model="ir.actions.act_window">
        <field name="name">Education Info</field>
        <field name="type">ir.actions.act_window</field>
        <field name="res_model">education.info</field>
        <field name="view_mode">list,form</field>
    </record>

    <menuitem id="menu_education_info" action='action_education_info' name="Education"
              parent="sub_menu_student_information"/>
</odoo>
