<odoo>

    <record id="education_info_tag_tree_view" model="ir.ui.view">
        <field name="name">education.info.tag.tree.view</field>
        <field name="model">education.info.tag</field>
        <field name="arch" type="xml">
            <list>

                <field name="name"/>


            </list>
        </field>
    </record>
    <record id="education_info_tag_form_view" model="ir.ui.view">
        <field name="name">education.info.tag.form.view</field>
        <field name="model">education.info.tag</field>
        <field name="arch" type="xml">
            <form>
                <sheet>
                    <group>
                        <field name="name"/>

                    </group>
                </sheet>
            </form>
        </field>
    </record>

    <record id="action_education_info_tag" model="ir.actions.act_window">
        <field name="name">Tags</field>
        <field name="type">ir.actions.act_window</field>
        <field name="res_model">education.info.tag</field>
        <field name="view_mode">list,form</field>
    </record>

    <menuitem id="menu_education_info_tag" action='action_education_info_tag' name="Tags"
              parent="menu_student_information"/>
</odoo>