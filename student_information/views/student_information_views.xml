<odoo>
    <record id="student_information_tree_view" model="ir.ui.view">
        <field name="name">student.information.tree.view</field>
        <field name="model">student.information</field>
        <field name="arch" type="xml">
            <list>
                <field name="name"/>
                <field name="entroll_no"/>
            </list>
        </field>
    </record>
    <record id="student_information_form_view" model="ir.ui.view">
        <field name="name">student.information.form.view</field>
        <field name="model">student.information</field>
        <field name="arch" type="xml">
            <form>
                <sheet>
                    <group>
                        <group>
                            <field name="name"/>
                            <field name="last_name"/>
                            <field name="full_name"/>
                            <field name="category"/>
                            <field name="category_note"/>
                        </group>
                        <group>
                            <field name="entroll_no"/>
                            <field name="partner_id"/>
                            <field name="email"/>
                            <field name="birth_date"/>
                            <field name="age"/>
                        </group>
                    </group>
                    <notebook>
                        <page string="Education Info">
                            <field name="education_info_ids"/>
                        </page>
                    </notebook>
                </sheet>
            </form>
        </field>
    </record>


    <record id="action_student_information" model="ir.actions.act_window">
        <field name="name">Student Information</field>
        <field name="type">ir.actions.act_window</field>
        <field name="res_model">student.information</field>
        <field name="view_mode">list,form</field>
    </record>

    <menuitem id="menu_student_information" action='action_student_information'
              name="Students"/>
</odoo>